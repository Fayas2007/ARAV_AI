# Neon PostgreSQL connection string
# Format: postgresql+psycopg://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# JWT Secret – generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# CORS – comma-separated origins
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,exp://localhost:19000

# Speech-to-text provider: "google" | "none"
STT_PROVIDER=none
STT_API_KEY=

# Text-to-speech provider: "google" | "none"  
TTS_PROVIDER=none
TTS_API_KEY=
